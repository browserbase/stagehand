module act_driver_lifecycle {
  pure val MAX_STEPS: int = 18

  type Phase =
    | Init
    | Settling
    | CacheLookup
    | CacheReplay
    | RouteSelect
    | WebMCPExec
    | LlmPlan
    | DomExec
    | RecoverOrRetry
    | Verify
    | CacheWrite
    | Done

  type Outcome =
    | Running
    | Success
    | Failed
    | TimedOut
    | Aborted

  type CacheStatus =
    | CacheNone
    | CacheHit
    | CacheMiss
    | CacheError

  type ExecRoute =
    | RouteNone
    | RouteCacheReplay
    | RouteWebMCP
    | RouteLlmDom

  type StopReason =
    | StopNone
    | StopTimeout
    | StopAbort

  type InFlightKind =
    | InFlightNone
    | InFlightCacheReplayStep
    | InFlightWebMCP
    | InFlightDomStep
    | InFlightSelfHealStep

  type DispatchResolution =
    | ResolutionNone
    | ResolutionNormal
    | LateAfterStop

  var phase: Phase
  var outcome: Outcome
  var domSettled: bool
  var readinessReady: bool
  var cacheBypass: bool
  var cacheStatus: CacheStatus
  var webMcpToolAvailable: bool
  var execRoute: ExecRoute
  var committedRoute: ExecRoute
  var plannedSteps: int
  var inFlight: InFlightKind
  var lastDispatchResolution: DispatchResolution
  var hasCancelSource: bool
  var stopSignal: StopReason
  var dispatchedAtStop: int
  var webMcpDispatched: int
  var webMcpCompleted: int
  var domActionsDispatched: int
  var domActionsCompleted: int
  var lateCompletionsAfterStop: int
  var verified: bool
  var recoveredOrRetried: bool
  var cacheEligible: bool
  var cacheWritten: bool
  var stepsTaken: int

  action init = {
    nondet cancelable = Set(true, false).oneOf()
    all {
      phase' = Init,
      outcome' = Running,
      domSettled' = false,
      readinessReady' = false,
      cacheBypass' = false,
      cacheStatus' = CacheNone,
      webMcpToolAvailable' = false,
      execRoute' = RouteNone,
      committedRoute' = RouteNone,
      plannedSteps' = 1,
      inFlight' = InFlightNone,
      lastDispatchResolution' = ResolutionNone,
      hasCancelSource' = cancelable,
      stopSignal' = StopNone,
      dispatchedAtStop' = -1,
      webMcpDispatched' = 0,
      webMcpCompleted' = 0,
      domActionsDispatched' = 0,
      domActionsCompleted' = 0,
      lateCompletionsAfterStop' = 0,
      verified' = false,
      recoveredOrRetried' = false,
      cacheEligible' = false,
      cacheWritten' = false,
      stepsTaken' = 0,
    }
  }

  action startAct(bypass: bool, toolAvail: bool, planned: int): bool = all {
    phase == Init,
    stopSignal == StopNone,
    planned.in(Set(1, 2)),
    phase' = Settling,
    outcome' = Running,
    domSettled' = false,
    readinessReady' = false,
    cacheBypass' = bypass,
    cacheStatus' = CacheNone,
    webMcpToolAvailable' = toolAvail,
    execRoute' = RouteNone,
    committedRoute' = RouteNone,
    plannedSteps' = planned,
    inFlight' = InFlightNone,
    lastDispatchResolution' = ResolutionNone,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = 0,
    webMcpCompleted' = 0,
    domActionsDispatched' = 0,
    domActionsCompleted' = 0,
    lateCompletionsAfterStop' = 0,
    verified' = false,
    recoveredOrRetried' = false,
    cacheEligible' = not(bypass),
    cacheWritten' = false,
    stepsTaken' = stepsTaken + 1,
  }

  action domSettleCompletes: bool = all {
    phase == Settling,
    stopSignal == StopNone,
    not(domSettled),
    domSettled' = true,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action readinessCompletes: bool = all {
    phase == Settling,
    stopSignal == StopNone,
    not(readinessReady),
    readinessReady' = true,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action advanceFromSettle: bool = all {
    phase == Settling,
    stopSignal == StopNone,
    domSettled,
    readinessReady,
    phase' = if (cacheBypass) RouteSelect else CacheLookup,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action cacheHit: bool = all {
    phase == CacheLookup,
    stopSignal == StopNone,
    phase' = CacheReplay,
    cacheStatus' = CacheHit,
    execRoute' = RouteCacheReplay,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    webMcpToolAvailable' = webMcpToolAvailable,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action cacheMissOrError(status: CacheStatus): bool = all {
    phase == CacheLookup,
    stopSignal == StopNone,
    status == CacheMiss or status == CacheError,
    phase' = RouteSelect,
    cacheStatus' = status,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action cacheReplayDispatchStep: bool = all {
    phase == CacheReplay,
    stopSignal == StopNone,
    inFlight == InFlightNone,
    domActionsDispatched < plannedSteps,
    inFlight' = InFlightCacheReplayStep,
    committedRoute' = RouteCacheReplay,
    domActionsDispatched' = domActionsDispatched + 1,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    plannedSteps' = plannedSteps,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action cacheReplayStepSucceed: bool = {
    val nextCompleted = domActionsCompleted + 1
    val finished = nextCompleted == plannedSteps
    all {
      phase == CacheReplay,
      stopSignal == StopNone,
      inFlight == InFlightCacheReplayStep,
      inFlight' = InFlightNone,
      lastDispatchResolution' = ResolutionNormal,
      domActionsCompleted' = nextCompleted,
      phase' = if (finished) Done else CacheReplay,
      outcome' = if (finished) Success else Running,
      verified' = if (finished) true else verified,
      stepsTaken' = stepsTaken + 1,
      domSettled' = domSettled,
      readinessReady' = readinessReady,
      cacheBypass' = cacheBypass,
      cacheStatus' = cacheStatus,
      webMcpToolAvailable' = webMcpToolAvailable,
      execRoute' = execRoute,
      committedRoute' = committedRoute,
      plannedSteps' = plannedSteps,
      hasCancelSource' = hasCancelSource,
      stopSignal' = stopSignal,
      dispatchedAtStop' = dispatchedAtStop,
      webMcpDispatched' = webMcpDispatched,
      webMcpCompleted' = webMcpCompleted,
      domActionsDispatched' = domActionsDispatched,
      lateCompletionsAfterStop' = lateCompletionsAfterStop,
      recoveredOrRetried' = recoveredOrRetried,
      cacheEligible' = cacheEligible,
      cacheWritten' = cacheWritten,
    }
  }

  action cacheReplayStepFailAfterDispatch: bool = all {
    phase == CacheReplay,
    stopSignal == StopNone,
    inFlight == InFlightCacheReplayStep,
    inFlight' = InFlightNone,
    lastDispatchResolution' = ResolutionNormal,
    phase' = Done,
    outcome' = Failed,
    verified' = false,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    recoveredOrRetried' = recoveredOrRetried,
    cacheWritten' = cacheWritten,
  }

  action cacheReplayPreCommitFail: bool = all {
    phase == CacheReplay,
    stopSignal == StopNone,
    inFlight == InFlightNone,
    committedRoute == RouteNone,
    domActionsDispatched == 0,
    phase' = RouteSelect,
    execRoute' = RouteNone,
    cacheStatus' = CacheMiss,
    recoveredOrRetried' = true,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    webMcpToolAvailable' = webMcpToolAvailable,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    cacheWritten' = cacheWritten,
  }

  action selectWebMCPRoute: bool = all {
    phase == RouteSelect,
    stopSignal == StopNone,
    webMcpToolAvailable,
    phase' = WebMCPExec,
    execRoute' = RouteWebMCP,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action selectLlmDriverRoute: bool = all {
    phase == RouteSelect,
    stopSignal == StopNone,
    phase' = LlmPlan,
    execRoute' = RouteLlmDom,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action webMcpDispatch: bool = all {
    phase == WebMCPExec,
    stopSignal == StopNone,
    inFlight == InFlightNone,
    webMcpDispatched == 0,
    inFlight' = InFlightWebMCP,
    committedRoute' = RouteWebMCP,
    webMcpDispatched' = webMcpDispatched + 1,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    plannedSteps' = plannedSteps,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action webMcpSucceed: bool = all {
    phase == WebMCPExec,
    stopSignal == StopNone,
    inFlight == InFlightWebMCP,
    inFlight' = InFlightNone,
    lastDispatchResolution' = ResolutionNormal,
    phase' = Verify,
    webMcpCompleted' = webMcpCompleted + 1,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action webMcpFailBeforeEffectFallbackToLlm: bool = all {
    phase == WebMCPExec,
    stopSignal == StopNone,
    inFlight == InFlightNone,
    committedRoute == RouteNone,
    webMcpDispatched == 0,
    phase' = LlmPlan,
    execRoute' = RouteLlmDom,
    recoveredOrRetried' = true,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    cacheWritten' = cacheWritten,
  }

  action webMcpFailAfterEffect: bool = all {
    phase == WebMCPExec,
    stopSignal == StopNone,
    inFlight == InFlightWebMCP,
    inFlight' = InFlightNone,
    lastDispatchResolution' = ResolutionNormal,
    phase' = Done,
    outcome' = Failed,
    verified' = false,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    recoveredOrRetried' = recoveredOrRetried,
    cacheWritten' = cacheWritten,
  }

  action llmPlanActionFound: bool = all {
    phase == LlmPlan,
    stopSignal == StopNone,
    phase' = DomExec,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action llmPlanNoAction: bool = all {
    phase == LlmPlan,
    stopSignal == StopNone,
    phase' = Done,
    outcome' = Failed,
    verified' = false,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    recoveredOrRetried' = recoveredOrRetried,
    cacheWritten' = cacheWritten,
  }

  action domExecDispatchStep: bool = all {
    phase == DomExec,
    stopSignal == StopNone,
    inFlight == InFlightNone,
    domActionsDispatched < plannedSteps,
    inFlight' = InFlightDomStep,
    committedRoute' = RouteLlmDom,
    domActionsDispatched' = domActionsDispatched + 1,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    plannedSteps' = plannedSteps,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action domExecStepSucceed: bool = {
    val nextCompleted = domActionsCompleted + 1
    val finished = nextCompleted == plannedSteps
    all {
      phase == DomExec,
      stopSignal == StopNone,
      inFlight == InFlightDomStep,
      inFlight' = InFlightNone,
      lastDispatchResolution' = ResolutionNormal,
      domActionsCompleted' = nextCompleted,
      phase' = if (finished) Verify else DomExec,
      stepsTaken' = stepsTaken + 1,
      outcome' = outcome,
      domSettled' = domSettled,
      readinessReady' = readinessReady,
      cacheBypass' = cacheBypass,
      cacheStatus' = cacheStatus,
      webMcpToolAvailable' = webMcpToolAvailable,
      execRoute' = execRoute,
      committedRoute' = committedRoute,
      plannedSteps' = plannedSteps,
      hasCancelSource' = hasCancelSource,
      stopSignal' = stopSignal,
      dispatchedAtStop' = dispatchedAtStop,
      webMcpDispatched' = webMcpDispatched,
      webMcpCompleted' = webMcpCompleted,
      domActionsDispatched' = domActionsDispatched,
      lateCompletionsAfterStop' = lateCompletionsAfterStop,
      verified' = verified,
      recoveredOrRetried' = recoveredOrRetried,
      cacheEligible' = cacheEligible,
      cacheWritten' = cacheWritten,
    }
  }

  action domExecPreCommitFailToSelfHeal: bool = all {
    phase == DomExec,
    stopSignal == StopNone,
    inFlight == InFlightNone,
    not(recoveredOrRetried),
    domActionsDispatched < plannedSteps,
    phase' = RecoverOrRetry,
    recoveredOrRetried' = true,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    cacheWritten' = cacheWritten,
  }

  action domExecFailTerminal: bool = all {
    phase == DomExec,
    stopSignal == StopNone,
    inFlight == InFlightNone or inFlight == InFlightDomStep,
    inFlight' = InFlightNone,
    lastDispatchResolution' = if (inFlight == InFlightDomStep) ResolutionNormal else lastDispatchResolution,
    phase' = Done,
    outcome' = Failed,
    verified' = false,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    recoveredOrRetried' = recoveredOrRetried,
    cacheWritten' = cacheWritten,
  }

  action selfHealDispatchStep: bool = all {
    phase == RecoverOrRetry,
    stopSignal == StopNone,
    inFlight == InFlightNone,
    domActionsDispatched < plannedSteps,
    inFlight' = InFlightSelfHealStep,
    committedRoute' = RouteLlmDom,
    domActionsDispatched' = domActionsDispatched + 1,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    plannedSteps' = plannedSteps,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action selfHealStepSucceed: bool = {
    val nextCompleted = domActionsCompleted + 1
    val finished = nextCompleted == plannedSteps
    all {
      phase == RecoverOrRetry,
      stopSignal == StopNone,
      inFlight == InFlightSelfHealStep,
      inFlight' = InFlightNone,
      lastDispatchResolution' = ResolutionNormal,
      domActionsCompleted' = nextCompleted,
      phase' = if (finished) Verify else DomExec,
      stepsTaken' = stepsTaken + 1,
      outcome' = outcome,
      domSettled' = domSettled,
      readinessReady' = readinessReady,
      cacheBypass' = cacheBypass,
      cacheStatus' = cacheStatus,
      webMcpToolAvailable' = webMcpToolAvailable,
      execRoute' = execRoute,
      committedRoute' = committedRoute,
      plannedSteps' = plannedSteps,
      hasCancelSource' = hasCancelSource,
      stopSignal' = stopSignal,
      dispatchedAtStop' = dispatchedAtStop,
      webMcpDispatched' = webMcpDispatched,
      webMcpCompleted' = webMcpCompleted,
      domActionsDispatched' = domActionsDispatched,
      lateCompletionsAfterStop' = lateCompletionsAfterStop,
      verified' = verified,
      recoveredOrRetried' = recoveredOrRetried,
      cacheEligible' = cacheEligible,
      cacheWritten' = cacheWritten,
    }
  }

  action selfHealFail: bool = all {
    phase == RecoverOrRetry,
    stopSignal == StopNone,
    inFlight == InFlightNone or inFlight == InFlightSelfHealStep,
    inFlight' = InFlightNone,
    lastDispatchResolution' = if (inFlight == InFlightSelfHealStep) ResolutionNormal else lastDispatchResolution,
    phase' = Done,
    outcome' = Failed,
    verified' = false,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    recoveredOrRetried' = recoveredOrRetried,
    cacheWritten' = cacheWritten,
  }

  action verifyPassed: bool = all {
    phase == Verify,
    stopSignal == StopNone,
    phase' = CacheWrite,
    verified' = true,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action verifyUnverified: bool = all {
    phase == Verify,
    stopSignal == StopNone,
    phase' = CacheWrite,
    verified' = false,
    cacheEligible' = false,
    stepsTaken' = stepsTaken + 1,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    recoveredOrRetried' = recoveredOrRetried,
    cacheWritten' = cacheWritten,
  }

  action finishWithCacheWrite: bool = all {
    phase == CacheWrite,
    stopSignal == StopNone,
    cacheEligible,
    phase' = Done,
    outcome' = Success,
    cacheWritten' = true,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
  }

  action finishSkipCacheWrite: bool = all {
    phase == CacheWrite,
    stopSignal == StopNone,
    phase' = Done,
    outcome' = Success,
    cacheWritten' = false,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
  }

  // Progress.run races stop signals without cancelling an already-issued CDP/WebMCP send,
  // so inFlight is preserved while dispatchedAtStop snapshots already-dispatched effects.
  action signalProgressStop(reason: StopReason): bool = all {
    phase != Done,
    hasCancelSource,
    stopSignal == StopNone,
    reason == StopTimeout or reason == StopAbort,
    stopSignal' = reason,
    dispatchedAtStop' = webMcpDispatched + domActionsDispatched,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action observeProgressStop: bool = all {
    phase != Done,
    stopSignal != StopNone,
    phase' = Done,
    outcome' = if (stopSignal == StopTimeout) TimedOut else Aborted,
    cacheEligible' = false,
    cacheWritten' = false,
    stepsTaken' = stepsTaken + 1,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
  }

  action resolveInFlightLateAfterStop: bool = all {
    stopSignal != StopNone,
    inFlight != InFlightNone,
    inFlight' = InFlightNone,
    lastDispatchResolution' = LateAfterStop,
    lateCompletionsAfterStop' = lateCompletionsAfterStop + 1,
    stepsTaken' = stepsTaken + 1,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
  }

  action stutterDone: bool = all {
    phase == Done,
    phase' = phase,
    outcome' = outcome,
    domSettled' = domSettled,
    readinessReady' = readinessReady,
    cacheBypass' = cacheBypass,
    cacheStatus' = cacheStatus,
    webMcpToolAvailable' = webMcpToolAvailable,
    execRoute' = execRoute,
    committedRoute' = committedRoute,
    plannedSteps' = plannedSteps,
    inFlight' = inFlight,
    lastDispatchResolution' = lastDispatchResolution,
    hasCancelSource' = hasCancelSource,
    stopSignal' = stopSignal,
    dispatchedAtStop' = dispatchedAtStop,
    webMcpDispatched' = webMcpDispatched,
    webMcpCompleted' = webMcpCompleted,
    domActionsDispatched' = domActionsDispatched,
    domActionsCompleted' = domActionsCompleted,
    lateCompletionsAfterStop' = lateCompletionsAfterStop,
    verified' = verified,
    recoveredOrRetried' = recoveredOrRetried,
    cacheEligible' = cacheEligible,
    cacheWritten' = cacheWritten,
    stepsTaken' = stepsTaken,
  }

  action step = any {
    {
      nondet bypass = Set(true, false).oneOf()
      nondet toolAvail = Set(true, false).oneOf()
      nondet planned = Set(1, 2).oneOf()
      startAct(bypass, toolAvail, planned)
    },
    domSettleCompletes,
    readinessCompletes,
    advanceFromSettle,
    cacheHit,
    {
      nondet st = Set(CacheMiss, CacheError).oneOf()
      cacheMissOrError(st)
    },
    cacheReplayDispatchStep,
    cacheReplayStepSucceed,
    cacheReplayStepFailAfterDispatch,
    cacheReplayPreCommitFail,
    selectWebMCPRoute,
    selectLlmDriverRoute,
    webMcpDispatch,
    webMcpSucceed,
    webMcpFailBeforeEffectFallbackToLlm,
    webMcpFailAfterEffect,
    llmPlanActionFound,
    llmPlanNoAction,
    domExecDispatchStep,
    domExecStepSucceed,
    domExecPreCommitFailToSelfHeal,
    domExecFailTerminal,
    selfHealDispatchStep,
    selfHealStepSucceed,
    selfHealFail,
    verifyPassed,
    verifyUnverified,
    finishWithCacheWrite,
    finishSkipCacheWrite,
    {
      nondet reason = Set(StopTimeout, StopAbort).oneOf()
      signalProgressStop(reason)
    },
    observeProgressStop,
    resolveInFlightLateAfterStop,
    stutterDone,
  }

  val atMostOneCommittedRoute: bool = and {
    (committedRoute == RouteNone) iff (webMcpDispatched == 0 and domActionsDispatched == 0),
    (committedRoute == RouteWebMCP) implies (webMcpDispatched > 0 and domActionsDispatched == 0),
    (committedRoute == RouteCacheReplay or committedRoute == RouteLlmDom) implies
      (domActionsDispatched > 0 and webMcpDispatched == 0),
    (committedRoute != RouteNone) implies (execRoute == committedRoute),
  }

  val neverBothToolAndDomClick: bool =
    not(webMcpDispatched > 0 and domActionsDispatched > 0)

  val boundedDispatchedActions: bool = and {
    webMcpDispatched <= 1,
    domActionsDispatched <= plannedSteps,
    webMcpCompleted <= webMcpDispatched,
    domActionsCompleted <= domActionsDispatched,
    lateCompletionsAfterStop <= 1,
    webMcpCompleted + domActionsCompleted + lateCompletionsAfterStop <=
      webMcpDispatched + domActionsDispatched,
  }

  val noCacheOnRecovery: bool =
    cacheWritten implies and {
      verified,
      not(recoveredOrRetried),
      not(cacheBypass),
    }

  val cancellationPreventsNewDispatch: bool = and {
    (lastDispatchResolution == LateAfterStop) implies (stopSignal != StopNone),
    (stopSignal != StopNone) implies and {
      webMcpDispatched + domActionsDispatched == dispatchedAtStop,
      not(cacheWritten),
      (lastDispatchResolution == LateAfterStop) implies (dispatchedAtStop > 0),
    },
  }

  val terminatesCleanly: bool = and {
    (phase == Done) iff (outcome != Running),
    (outcome == Failed or outcome == TimedOut or outcome == Aborted) implies not(cacheWritten),
    (outcome == Success) implies and {
      inFlight == InFlightNone,
      committedRoute != RouteNone,
      (committedRoute == RouteWebMCP) implies (webMcpCompleted == 1 and domActionsDispatched == 0),
      (committedRoute == RouteCacheReplay or committedRoute == RouteLlmDom) implies
        (domActionsCompleted == plannedSteps and webMcpDispatched == 0),
    },
    stepsTaken <= MAX_STEPS,
  }

  val allInvariants: bool = and {
    atMostOneCommittedRoute,
    neverBothToolAndDomClick,
    boundedDispatchedActions,
    noCacheOnRecovery,
    cancellationPreventsNewDispatch,
    terminatesCleanly,
  }
}
