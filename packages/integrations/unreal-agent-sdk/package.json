{
  "name": "@browserbasehq/stagehand-integrations-unreal-agent-sdk",
  "version": "4.0.0",
  "private": true,
  "description": "Unreal Agent runner adapter for Stagehand integrations",
  "files": ["dist"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "pnpm run build && vitest run --root ../../.. packages/integrations/unreal-agent-sdk/tests",
    "test:unit": "vitest run --root ../../.. packages/integrations/unreal-agent-sdk/tests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@browserbasehq/stagehand-integrations": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": { "node": ">=22.18.0" }
}
