{
  "cases": [
    {
      "name": "screenshot artifacts are written relative to the artifact root",
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "await page.screenshot({ path: 'shots/first.png' }); return 'ok';"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": "ok",
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [
                  {
                    "path": "shots/first.png",
                    "base64": "iVBORw0KGgo="
                  },
                  {
                    "path": "second.png",
                    "base64": "AAEC"
                  }
                ],
                "closeRequested": false,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "result": "ok"
          }
        }
      ],
      "expect": {
        "closed": false,
        "tree": [
          "artifacts/",
          "artifacts/second.png",
          "artifacts/shots/",
          "artifacts/shots/first.png"
        ],
        "files": {
          "artifacts/shots/first.png": "iVBORw0KGgo=",
          "artifacts/second.png": "AAEC"
        }
      }
    },
    {
      "name": "an existing regular file at the artifact path is overwritten",
      "fs": [
        {
          "file": "artifacts/shot.png",
          "base64": "b2xk"
        }
      ],
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "await page.screenshot({ path: 'shot.png' });"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": null,
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [
                  {
                    "path": "shot.png",
                    "base64": "iVBORw0KGgo="
                  }
                ],
                "closeRequested": false,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "result": null
          }
        }
      ],
      "expect": {
        "tree": ["artifacts/", "artifacts/shot.png"],
        "files": {
          "artifacts/shot.png": "iVBORw0KGgo="
        }
      }
    },
    {
      "name": "a parent-directory path is rejected",
      "fs": [
        {
          "dir": "outside"
        },
        {
          "file": "outside/existing.png",
          "base64": "cHJlc2VydmU="
        }
      ],
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "await page.screenshot({ path: 'x.png' });"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": null,
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [
                  {
                    "path": "../escape.png",
                    "base64": "iVBORw0KGgo="
                  }
                ],
                "closeRequested": false,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "SCREENSHOT_ARTIFACT_PATH_ERROR"
            }
          }
        }
      ],
      "expect": {
        "closed": false,
        "tree": ["artifacts/", "outside/", "outside/existing.png"],
        "files": {
          "outside/existing.png": "cHJlc2VydmU="
        }
      }
    },
