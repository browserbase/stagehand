{
  "cases": [
    {
      "name": "run returns the envelope value",
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "return { answer: 42 };"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": {
                  "answer": 42
                },
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [],
                "closeRequested": false,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "result": {
              "answer": 42
            }
          },
          "sent": [
            {
              "callback": "run",
              "code": "return { answer: 42 };"
            }
          ]
        }
      ],
      "expect": {
        "closed": false,
        "tree": ["artifacts/"]
      }
    },
