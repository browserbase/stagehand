{
  "cases": [
    {
      "name": "close requested closes the session after returning the value",
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "await browser.close(); return 'done';"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": "done",
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [],
                "closeRequested": true,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "result": "done"
          }
        },
        {
          "call": {
            "tool": "run",
            "code": "return 1;"
          },
          "batch": [],
          "sent": [],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "FACADE_BROWSER_CLOSED_ERROR"
            }
          }
        }
      ],
      "expect": {
        "closed": true
      }
    },
    {
      "name": "close requested still closes when the code threw",
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "await browser.close(); throw new Error('agent failure');"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": null,
                "executionError": {
                  "name": "Error",
                  "message": "agent failure"
                },
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [],
                "closeRequested": true,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "error": {
              "kind": "execution",
              "name": "Error",
              "message": "agent failure"
            }
          }
        },
        {
          "call": {
            "tool": "run",
            "code": "return 1;"
          },
          "batch": [],
          "sent": [],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "FACADE_BROWSER_CLOSED_ERROR"
            }
          }
        }
      ],
      "expect": {
        "closed": true
      }
    },
    {
      "name": "close requested still closes when an artifact path is rejected",
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "await page.screenshot({ path: '../x.png' }); await browser.close();"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": null,
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [
                  {
                    "path": "../x.png",
                    "base64": "iVBORw0KGgo="
                  }
                ],
                "closeRequested": true,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "SCREENSHOT_ARTIFACT_PATH_ERROR"
            }
          }
        },
        {
          "call": {
            "tool": "run",
            "code": "return 1;"
          },
          "batch": [],
          "sent": [],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "FACADE_BROWSER_CLOSED_ERROR"
            }
          }
        }
      ],
      "expect": {
        "closed": true,
        "tree": ["artifacts/"]
      }
    },
