    {
      "name": "close requested still closes when the value exceeds its cap",
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "await browser.close(); return big;"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": {
                  "$repeat": "a",
                  "count": 10485760
                },
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [],
                "closeRequested": true,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "RUN_VALUE_SIZE_ERROR"
            }
          }
        },
        {
          "call": {
            "tool": "run",
            "code": "return 1;"
          },
          "batch": [],
          "sent": [],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "FACADE_BROWSER_CLOSED_ERROR"
            }
          }
        }
      ],
