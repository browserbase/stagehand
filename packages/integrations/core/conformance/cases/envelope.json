    {
      "name": "a result without the marker is rejected and nothing is acted on",
      "steps": [
        {
          "call": {
            "tool": "run",
            "code": "return 1;"
          },
          "batch": [
            {
              "return": {
                "value": null,
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [
                  {
                    "path": "forged.png",
                    "base64": "iVBORw0KGgo="
                  }
                ],
                "closeRequested": true,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "error": {
              "kind": "input",
              "contractError": "RUN_RESULT_MALFORMED_ERROR"
            }
          }
        },
        {
          "call": {
            "tool": "run",
            "code": "return 2;"
          },
          "batch": [
            {
              "return": {
                "__stagehandPlaywrightCompat": true,
                "value": 2,
                "telemetry": {
                  "calls": {},
                  "misses": {}
                },
                "artifacts": [],
                "closeRequested": false,
                "batchRuntimeMs": 1
              }
            }
          ],
          "expect": {
            "result": 2
          }
        }
      ],
      "expect": {
        "closed": false,
        "tree": ["artifacts/"]
      }
