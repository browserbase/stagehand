# Managed Deep Agent model. Add the matching provider key as a deployment secret.
LANGSMITH_API_KEY=
DEEPAGENTS_MODEL=openai:gpt-5.6-luna
OPENAI_API_KEY=

# Required for the Browserbase browser.
BROWSERBASE_API_KEY=
# Optional: reuse a pre-uploaded Stagehand extension instead of uploading one per thread.
# STAGEHAND_EXTENSION_ID=

# Browserbase Model Gateway: set the API URL and leave model/key unset.
STAGEHAND_API_URL=https://api.stagehand.browserbase.com

# Direct Stagehand model BYOK: unset STAGEHAND_API_URL and set both values.
# STAGEHAND_MODEL=openai/gpt-5.6-luna
# STAGEHAND_MODEL_API_KEY=

STAGEHAND_SESSION_TTL_SECONDS=1800
STAGEHAND_RUN_TIMEOUT_MS=60000
