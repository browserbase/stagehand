# Copy to .env in this directory (or the repo root) and fill in.
# A variable already set in the environment always wins over this file.

# Required. TypeSafe key — Jev makes every decision the agent takes.
# https://docs.typesafe.ai
TYPESAFE_API_KEY=""

# Required. Used by extract(), and by act()/observe() when they fall back to
# the LLM pipeline. Set MODEL_API_KEY instead when --model names a provider
# other than OpenAI; it takes precedence when both are present.
OPENAI_API_KEY=""
# MODEL_API_KEY=""

# Optional. Point Jev at a different TypeSafe deployment or model.
# TYPESAFE_API_URL="https://api.typesafe.ai"
# TYPESAFE_MODEL="jev-latest"

# Optional. Set this only if Chrome cannot be detected automatically.
# CHROME_PATH=""
