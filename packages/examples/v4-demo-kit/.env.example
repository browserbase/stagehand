# Optional. If this value is not set, the demos use local Chrome.
BROWSERBASE_API_KEY=

# Optional. Browserbase Model Gateway supplies the model for hosted sessions.
# Set both values when you use AI methods with local Chrome.
STAGEHAND_MODEL_NAME=openai/gpt-5.4-mini
STAGEHAND_MODEL_API_KEY=

# The model that makes decisions in the agent-harness demo.
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.4-mini

# Required only for the HTTP demo.
DEMO_BEARER_TOKEN=
PORT=8787
