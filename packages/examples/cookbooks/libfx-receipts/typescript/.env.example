BROWSERBASE_API_KEY=
OPENAI_API_KEY=
# Stagehand browser model, without the openai/ prefix:
BROWSER_MODEL=gpt-6-luna
# One run per directory. Change this to start a separate task:
STATE_DIR=out/run
AI_GATEWAY_API_KEY=
AGENT_MODEL=openai/gpt-6-luna
# JSON array of your actual merchant receipt-list pages, at most five:
RECEIPT_URLS=[]
# Set to 1 for a crash after the first newly saved page. Unset before resume.
CRASH_AFTER_RECEIPT=0
