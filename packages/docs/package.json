{
  "name": "@browserbasehq/stagehand-docs",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "mint validate && mint broken-links --check-anchors --check-redirects --check-snippets && mint a11y --skip-contrast",
