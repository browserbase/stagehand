{
  "valid": [
    {
      "name": "empty normalized text",
      "chain": { "steps": [{ "type": "query", "selector": { "kind": "textMatch", "value": "" } }] }
    },
    {
      "name": "exact Unicode text with literal delimiters",
      "chain": {
        "steps": [
          {
            "type": "query",
            "selector": { "kind": "textMatch", "value": " 保存 >> Sa​ve­ ", "exact": true }
          }
        ]
      }
    },
    {
      "name": "substring text",
      "chain": {
        "steps": [
          { "type": "query", "selector": { "kind": "textMatch", "value": "Save", "exact": false } }
        ]
      }
    },
    {
      "name": "single CSS query",
      "chain": { "steps": [{ "type": "query", "selector": { "kind": "css", "value": "button" } }] }
    },
    {
      "name": "XPath with whitespace and predicates preserved",
      "chain": {
        "steps": [
          {
            "type": "query",
            "selector": { "kind": "xpath", "value": " .//button[normalize-space(.)='Save'] " }
          }
        ]
      }
    },
    {
      "name": "legacy text with Unicode and literal delimiters",
      "chain": {
        "steps": [
          { "type": "query", "selector": { "kind": "text", "value": "  保存 >> / 'Save'  " } }
        ]
      }
    },
    {
      "name": "position before a descendant query",
      "chain": {
        "steps": [
          { "type": "query", "selector": { "kind": "css", "value": ".card" } },
          { "type": "nth", "index": 1 },
          { "type": "query", "selector": { "kind": "css", "value": "button" } }
        ]
      }
    },
    {
      "name": "position after a descendant query",
      "chain": {
        "steps": [
          { "type": "query", "selector": { "kind": "css", "value": ".card" } },
          { "type": "query", "selector": { "kind": "css", "value": "button" } },
          { "type": "nth", "index": 1 }
        ]
      }
    },
    {
      "name": "repeated positions including zero",
      "chain": {
        "steps": [
          { "type": "query", "selector": { "kind": "css", "value": ".card" } },
          { "type": "nth", "index": 2 },
          { "type": "nth", "index": 0 },
          { "type": "query", "selector": { "kind": "css", "value": "button" } }
        ]
      }
    },
    {
      "name": "iframe element as the final target",
      "chain": {
        "steps": [{ "type": "query", "selector": { "kind": "css", "value": "iframe.checkout" } }]
      }
    },
    {
      "name": "ordinary query following an iframe query",
      "chain": {
        "steps": [
          { "type": "query", "selector": { "kind": "css", "value": "iframe.checkout" } },
          { "type": "query", "selector": { "kind": "css", "value": "button" } }
        ]
      }
    },
    {
      "name": "explicit legacy frame hops with positions",
      "chain": {
        "steps": [
          { "type": "query", "selector": { "kind": "css", "value": "iframe.checkout" } },
          { "type": "nth", "index": 0 },
          { "type": "frame", "selector": { "kind": "css", "value": "iframe.payment" } },
          { "type": "frame", "selector": { "kind": "xpath", "value": "//button" } },
          { "type": "nth", "index": 1 }
        ]
      }
    }
  ],
