{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Node",
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "children": {
          "items": { "$ref": "#/$defs/Node" },
          "type": "array"
        }
      },
      "required": ["value"]
    }
  }
}
