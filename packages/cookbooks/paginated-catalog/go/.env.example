# Required for cloud browser and Browserbase Model Gateway.
BROWSERBASE_API_KEY=
# OpenAI model key.
OPENAI_API_KEY=
# Maximum total pages across resumed runs. Default 2, maximum 100.
# MAX_PAGES=2
# Default: a two-page mystery category. Set the root URL for the full catalog.
# CATALOG_URL=https://books.toscrape.com/catalogue/category/books/mystery_3/index.html
# One writer per output directory. Change OUT_DIR to start a fresh export.
# OUT_DIR=out
# Stable selector proving whether another page exists. Adapt for your site.
# NEXT_SELECTOR=li.next a
