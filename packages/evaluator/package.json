{
  "name": "@browserbasehq/stagehand-evaluator",
  "version": "4.0.0",
  "private": true,
  "bin": {
    "stagehand-evaluator": "./dist/cli.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
