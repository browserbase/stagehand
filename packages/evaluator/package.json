    "test:unit": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.53",
    "@ai-sdk/openai": "^2.0.53",
    "ai": "^5.0.185",
    "sharp": "^0.34.5",
    "zod": "catalog:"
